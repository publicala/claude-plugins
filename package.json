{
  "name": "claude-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "postinstall": "bun install --cwd plugins/blueprint --frozen-lockfile",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run validate:json && bun run validate:plugins && bun run lint:md && bun run check:prose && bun run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "validate:json": "bun scripts/validate-json.ts",
    "validate:plugins": "bun scripts/validate-plugins.ts",
    "lint:md": "markdownlint-cli2",
    "check:prose": "bun scripts/check-prose.ts",
    "test": "bun test --config=bunfig.test.toml --coverage",
    "update:icons": "bun scripts/update-blueprint-icons.ts"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "happy-dom": "^21.0.4",
    "jsonc-parser": "3.3.1",
    "lefthook": "2.2.2",
    "lucide-static": "^1.59.0",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
