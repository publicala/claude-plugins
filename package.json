{
  "name": "claude-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "postinstall": "bun install --cwd plugins/blueprint --frozen-lockfile",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run validate:json && bun run validate:plugins && bun run check:prose && bun test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun --bun eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "validate:json": "bun scripts/validate-json.ts",
    "validate:plugins": "bun scripts/validate-plugins.ts",
    "check:prose": "bun scripts/check-prose.ts",
    "update:icons": "bun scripts/update-blueprint-icons.ts"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "jsonc-parser": "3.3.1",
    "lefthook": "2.2.2",
    "lucide-static": "^1.48.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0"
  }
}
